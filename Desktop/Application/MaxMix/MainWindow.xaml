<mah:MetroWindow x:Class="MaxMix.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:local="clr-namespace:MaxMix"
    xmlns:ap="clr-namespace:MaxMix.Framework.AttachedProperties"
    MinWidth="820" MinHeight="680" Width="940" Height="860"
    WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
    ShowMaxRestoreButton="True" ShowMinButton="True" ShowCloseButton="True"
    Background="{StaticResource Brush_WindowBackground}" Foreground="#E2EAF7"
    FontFamily="{StaticResource FontFamily_Default}" FontSize="13"
    BorderBrush="{StaticResource Brush_Border}" BorderThickness="1"
    TitleCharacterCasing="Normal" TitleBarHeight="34" ShowIconOnTitleBar="False"
    WindowTitleBrush="#0E1320" NonActiveWindowTitleBrush="#0E1320" TitleForeground="#9AAAC2"
    GlowBrush="#597DF5" Icon="/MaxMix;component/Resources/app.ico"
    Visibility="{Binding IsActive, Converter={StaticResource Cnv_BoolToVisibility}}"
    local:MainWindow.CloseCommand="{Binding DeactivateCommand}">
    <Grid>
        <tb:TaskbarIcon x:Name="taskbarIcon"
            IconSource="{Binding IsConnected, Converter={StaticResource Cnv_BoolToString}, ConverterParameter={StaticResource Tray_Icons}}"
            ToolTipText="{Binding ConnectionStatus}" MenuActivation="RightClick"
            DoubleClickCommand="{Binding ActivateCommand}"
            ap:BalloonMessageProperty.BallonMessage="{Binding IsConnected, Converter={StaticResource Cnv_BoolToString}, ConverterParameter={StaticResource Tray_Status_Messages}}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Apri Maxmix" Command="{Binding ActivateCommand}" />
                    <MenuItem Header="Riconnetti dispositivo" Command="{Binding ReconnectCommand}" />
                    <Separator />
                    <MenuItem Header="Esci" Command="{Binding RequestExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        <Grid Margin="28,18,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="MAXMIX" FontSize="29" FontWeight="Bold" Foreground="#F4F7FF" />
                    <TextBlock Text="Il tuo controller audio" Style="{StaticResource Caption}" Margin="1,3,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#202C46" CornerRadius="16" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F5B85B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="#63E3BC" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="IN ATTESA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Text" Value="COLLEGATO" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,20,20">
                                <TextBlock Text="Dispositivo" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <TextBlock x:Name="ConnectionStatusText" Text="{Binding ConnectionStatus}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Carica firmware" Command="{Binding FirmwareCommand}" Style="{StaticResource ActionButton}"
                                Margin="0,0,10,0" ToolTip="Installa o aggiorna Maxmix su un Nano ATmega328P, anche nuovo con bootloader Arduino" />
                            <Button Content="Riconnetti" Command="{Binding ReconnectCommand}" Style="{StaticResource ActionButton}"
                                VerticalAlignment="Top" Padding="18,8" Background="#4169E1" Foreground="White"
                                BorderThickness="0" ToolTip="Riavvia la ricerca e la connessione al controller" />
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PORTA USB" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding ConnectedPort}" Margin="0,7,0,0" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FIRMWARE" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding FirmwareVersion}" Margin="0,7,0,0" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RECUPERO CONNESSIONE" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="Automatico" Margin="0,7,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#83A6FF" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="Personalizza il controller" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <ContentPresenter Content="{Binding SettingsViewModel}" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="Maxmix 1.5.9 · Edizione locale" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Esci" Command="{Binding RequestExitCommand}" Style="{StaticResource ActionButton}" Margin="0,0,12,0" Padding="16,6" />
                    <Button Content="Nascondi nella barra" Command="{Binding DeactivateCommand}" Style="{StaticResource ActionButton}" Padding="16,6" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>
