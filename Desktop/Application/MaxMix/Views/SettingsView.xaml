<UserControl x:Class="MaxMix.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:comm="clr-namespace:MaxMix.Services.Communication">
    <UserControl.Resources>
        <Style TargetType="xctk:ColorPicker">
            <Setter Property="Width" Value="130" />
            <Setter Property="Margin" Value="0,6,12,0" />
            <Setter Property="DisplayColorAndName" Value="True" />
            <Setter Property="Background" Value="#202C46" />
            <Setter Property="Foreground" Value="#F3F6FC" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="Avvia con Windows" IsChecked="{Binding RunAtStartup}" Style="{StaticResource SettingCheckBox}" />
                <CheckBox Content="Passa alle nuove applicazioni" IsChecked="{Binding DisplayNewSession}" Style="{StaticResource SettingCheckBox}" />
                <CheckBox Content="Scorrimento circolare" IsChecked="{Binding LoopAroundItems}" Style="{StaticResource SettingCheckBox}" />
                <TextBlock Text="MODALITÀ ALL'AVVIO" Style="{StaticResource Caption}" FontSize="10" Margin="0,8,0,8" />
                <ComboBox SelectedValue="{Binding StartupMode, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,24">
                    <ComboBoxItem Content="Uscite audio" Tag="{x:Static comm:DisplayMode.MODE_OUTPUT}" />
                    <ComboBoxItem Content="Ingressi e microfoni" Tag="{x:Static comm:DisplayMode.MODE_INPUT}" />
                    <ComboBoxItem Content="Applicazioni" Tag="{x:Static comm:DisplayMode.MODE_APPLICATION}" />
                    <ComboBoxItem Content="Mix gioco e chat" Tag="{x:Static comm:DisplayMode.MODE_GAME}" />
                </ComboBox>
                <Border Height="1" Background="{StaticResource Brush_Border}" Margin="0,0,0,22" />
                <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="Spegni lo schermo quando inattivo" IsChecked="{Binding SleepWhenInactive}" Style="{StaticResource SettingCheckBox}" />
                <Grid Margin="0,0,0,8" IsEnabled="{Binding SleepWhenInactive}">
                    <TextBlock Text="Attesa prima dello spegnimento" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SleepAfterSeconds, StringFormat={}{0} s}" HorizontalAlignment="Right" Foreground="#A4BCFF" />
                </Grid>
                <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SleepAfterSeconds}" IsEnabled="{Binding SleepWhenInactive}" />
            </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Manopola" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Accelerazione" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding AccelerationPercentage, StringFormat={}{0}%}" HorizontalAlignment="Right" Foreground="#A4BCFF" />
                </Grid>
                <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AccelerationPercentage}" Margin="0,0,0,16" />
                <TextBlock Text="Aumenta la variazione del volume quando giri la manopola più velocemente."
                           Style="{StaticResource Caption}" />
                <Grid Margin="0,20,0,8">
                    <TextBlock Text="Intervallo doppio clic" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DoubleTapTime, StringFormat={}{0} ms}" HorizontalAlignment="Right" Foreground="#A4BCFF" />
                </Grid>
                <Slider Minimum="1" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding DoubleTapTime}" IsEnabled="{Binding CanSetDoubleTapTime}"
                        ToolTip="Regola il tempo tra due pressioni del pulsante. Richiede firmware 1.5.8." />
            </StackPanel>
        </Border>
        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Illuminazione" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Volume · minimo e massimo" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <xctk:ColorPicker SelectedColor="{Binding VolumeMinColor, Converter={StaticResource Cnv_ColorToUint32}}" ToolTip="Colore volume minimo" />
                    <xctk:ColorPicker SelectedColor="{Binding VolumeMaxColor, Converter={StaticResource Cnv_ColorToUint32}}" ToolTip="Colore volume massimo" />
                </StackPanel>
                <TextBlock Text="Mix · canale A e canale B" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal">
                    <xctk:ColorPicker SelectedColor="{Binding MixChannelAColor, Converter={StaticResource Cnv_ColorToUint32}}" ToolTip="Colore canale A" />
                    <xctk:ColorPicker SelectedColor="{Binding MixChannelBColor, Converter={StaticResource Cnv_ColorToUint32}}" ToolTip="Colore canale B" />
                </StackPanel>
                <TextBlock Text="Colori per modalità e stato" Style="{StaticResource Caption}" Margin="0,18,0,4" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Microfono" Style="{StaticResource Caption}" />
                        <xctk:ColorPicker SelectedColor="{Binding InputColor, Converter={StaticResource Cnv_ColorToUint32}}" ToolTip="Colore modalità microfono" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Applicazioni" Style="{StaticResource Caption}" />
                        <xctk:ColorPicker SelectedColor="{Binding ApplicationColor, Converter={StaticResource Cnv_ColorToUint32}}" ToolTip="Colore modalità applicazioni" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Mute" Style="{StaticResource Caption}" />
                        <xctk:ColorPicker SelectedColor="{Binding MuteColor, Converter={StaticResource Cnv_ColorToUint32}}" ToolTip="Colore pulsazione mute" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Disconnesso" Style="{StaticResource Caption}" />
                        <xctk:ColorPicker SelectedColor="{Binding DisconnectedColor, Converter={StaticResource Cnv_ColorToUint32}}" ToolTip="Colore rotazione durante la disconnessione" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="I colori sono salvati sul PC. Questi quattro profili richiedono firmware 1.5.9."
                           Style="{StaticResource Caption}" Margin="0,12,0,0" />
                <TextBlock Text="Uscite: anello volume · Microfono: inverso · App: simmetrico · Gioco/chat: due semicerchi."
                           Style="{StaticResource Caption}" Margin="0,18,0,0" />
                <TextBlock Text="Mute: pulsazione lenta · Disconnesso: rotazione · Riposo: spento."
                           Style="{StaticResource Caption}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
