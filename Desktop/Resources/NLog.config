<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <targets async="true">
    <target name="logconsole" xsi:type="Console" />
    <target name="logfile" xsi:type="File" fileName="${specialfolder:folder=LocalApplicationData}/Maxmix/logs/info.log"
            archiveAboveSize="2097152" maxArchiveFiles="3" archiveNumbering="Rolling" />
  </targets>

  <rules>
    <logger name="*" minlevel="Warn" writeTo="logconsole" />
    <logger name="*" minlevel="Info" writeTo="logfile" />
  </rules>
</nlog>
